        ".agents/scripts/check-feature-map.mjs",
        "check",
        ".agents/features/notebooks-backend.json"
      ]
    },
    {
      "id": "live-backend-test",
      "cwd": ".",
      "argv": [
        "powershell.exe",
        "-NoProfile",
