        "scripts/local.ps1",
        "test"
      ]
    },
    {
      "id": "contract-validate",
      "cwd": "frontend",
      "argv": [
        "npm",
        "run",
        "contract:validate"
      ]
    }
  ],
  "unresolved": [
    "pint, composer analyse and the concurrency evidence are focused Lead checks, not recipe checks.",
    "The backend suite needs a warm worktree test runtime to stay inside the 120 s check limit."
  ]
