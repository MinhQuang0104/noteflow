{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "contract:validate": "redocly lint ../contracts/openapi.yaml --config ../redocly.yaml",
    "contract:generate": "node scripts/generate-openapi-types.mjs",
    "contract:check": "node scripts/generate-openapi-types.mjs --check",
    "contract:proof": "node scripts/prove-contract-drift.mjs",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@emnapi/wasi-threads": "1.2.3",
    "@redocly/cli": "^2.53.2",
    "@tailwindcss/vite": "4.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3",
    "tslib": "2.8.1",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
